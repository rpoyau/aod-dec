# Compiler input: exact occurrence classification, followed by exact host current assembly.
# mode 0 packs orientation and flags; mode 1 computes swept membership.
dec coefficient(mode: int, left: int, right: int, available: int, kind: int) -> int:
    assert mode == 0 or mode == 1
    assert left == 0 or left == 1
    assert right == 0 or right == 1
    assert available == 0 or available == 1
    assert kind >= 0 and kind <= 2
    let orientation = left - right
    let selected = select(available == 1 and orientation != 0, 1, 0)
    let internal = select(left == 1 and right == 1, 1, 0)
    let exterior = select(left == 0 and right == 0, 1, 0)
    let inactive = 1 - available
    let bucket = select(selected == 1, kind + 1, 0)
    select(
        mode == 0,
        orientation + 1 + 3 * selected + 6 * internal + 12 * exterior + 24 * inactive + 48 * bucket,
        orientation,
    )

dec main() -> int:
    coefficient(0, 1, 0, 1, 0)
