# Each return retains the start and a structural hinge.
dec recur(t: trace) -> trace:
    let t1 = step(t, q4(1), +1t)
    let t2 = hinge(t1)
    let t3 = step(t2, q4(0), -1t)
    close(t3)

dec main() -> int:
    let a0 = trace("B", "a", q4(0))
    let a1 = recur(a0)
    assert phases(a1) == 1
    assert beats(a1) == 0
    let a2 = close(a1)
    assert phases(a2) == 1
    let a3 = recur(a2)
    assert phases(a3) == 2
    assert beats(a3) == 1
    emit a3
    emit rate(a3)
    0
