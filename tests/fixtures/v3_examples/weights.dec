# A declared exact ternary continuation kernel, no implicit sampling law.
dec main() -> int:
    let returned = probability(2, 1, 3, -1t)
    let hinge_weight = probability(2, 1, 3, 0t)
    let outgoing = probability(2, 1, 3, +1t)
    assert returned + hinge_weight + outgoing == 1/1r
    emit returned
    emit hinge_weight
    emit outgoing
    0
