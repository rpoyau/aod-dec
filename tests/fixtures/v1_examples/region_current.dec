Dec scoped_flux(capacity, duration, window, lag, intensity) -> result:
    (int capacity, int duration, int window, int lag, ratio intensity) -> ratio result:
        assert capacity >= 0 and duration >= 0 and window >= 0
        assert intensity >= ratio(0, 1)
        int participation = duration if duration < window else window
        result = ratio(capacity * participation * lag, 1) * intensity

Dec oriented_current(value, source_inside, target_inside, available) -> result:
    (ratio value, int source_inside, int target_inside, int available) -> ratio result:
        assert source_inside == 0 or source_inside == 1
        assert target_inside == 0 or target_inside == 1
        assert available == 0 or available == 1
        result = value * ratio(source_inside - target_inside, 1) if available == 1 else ratio(0, 1)

Dec swept_current(value, before_inside, after_inside) -> result:
    (ratio value, int before_inside, int after_inside) -> ratio result:
        assert value >= ratio(0, 1)
        assert before_inside == 0 or before_inside == 1
        assert after_inside == 0 or after_inside == 1
        result = value * ratio(after_inside - before_inside, 1)

Dec moving_current(crossing, sweep, shedding) -> result:
    (ratio crossing, ratio sweep, ratio shedding) -> ratio result:
        result = crossing - sweep + shedding

Dec main() -> result:
    () -> int result:
        ratio channel = scoped_flux(3, 5, 4, 1, ratio(1, 3))
        assert channel == ratio(4, 1)
        emit oriented_current(channel, 1, 0, 1)
        emit oriented_current(channel, 0, 1, 1)
        emit oriented_current(channel, 1, 1, 1)
        emit oriented_current(channel, 1, 0, 0)
        emit moving_current(ratio(8, 1), swept_current(ratio(3, 1), 0, 1), ratio(2, 1))
        result = 0
