# SoA vs AoS exact integer layout benchmark (`PR 9`, Pillar 3):
# - Compares Structure-of-Arrays (`[int]` parallel lanes) against Array-of-Structures (`[CellPair]`)
#   over an identical exact recurrence via `evolve` + persistent `list_set`, verifying 100%
#   identical outputs with zero floats.
# - Comfortably fits within DEFAULT_FUEL = 100_000 for Exact VM, AOT, and ORC LLJIT parity.

use aod::core:
    list_set, evolve

struct CellPair:
    a: int
    b: int

dec soa_lane_step:
    ((lane_a, lane_b, acc): ([int], [int], int), j: int, step: int) -> ([int], [int], int):
        let va = lane_a[j]
        let vb = lane_b[j]
        let next_a = (va + vb + step) % 1000003
        let next_b = (vb + j + 1) % 1000003
        let next_la = list_set(lane_a, j, next_a)
        let next_lb = list_set(lane_b, j, next_b)
        return (next_la, next_lb, (acc + next_a - next_b) % 1000000007)

dec soa_outer_step:
    ((lane_a, lane_b, acc): ([int], [int], int), step: int) -> ([int], [int], int):
        return evolve((lane_a, lane_b, acc), 0..8, soa_lane_step, step)

dec run_soa_kernel:
    (n: int) -> int:
        let init_a = [1, 3, 5, 7, 11, 13, 17, 19]
        let init_b = [2, 4, 6, 8, 10, 12, 14, 16]
        let (_, _, acc) = evolve((init_a, init_b, 0), 0..n, soa_outer_step)
        return acc

dec aos_lane_step:
    ((pairs, acc): ([CellPair], int), j: int, step: int) -> ([CellPair], int):
        let p = pairs[j]
        let next_a = (p.a + p.b + step) % 1000003
        let next_b = (p.b + j + 1) % 1000003
        let next_pairs = list_set(pairs, j, CellPair(next_a, next_b))
        return (next_pairs, (acc + next_a - next_b) % 1000000007)

dec aos_outer_step:
    ((pairs, acc): ([CellPair], int), step: int) -> ([CellPair], int):
        return evolve((pairs, acc), 0..8, aos_lane_step, step)

dec run_aos_kernel:
    (n: int) -> int:
        let init_pairs = [
            CellPair(1, 2),
            CellPair(3, 4),
            CellPair(5, 6),
            CellPair(7, 8),
            CellPair(11, 10),
            CellPair(13, 12),
            CellPair(17, 14),
            CellPair(19, 16)
        ]
        let (_, acc) = evolve((init_pairs, 0), 0..n, aos_outer_step)
        return acc

dec main:
    () -> int:
        let soa_res = run_soa_kernel(64)
        let aos_res = run_aos_kernel(64)
        assert soa_res == aos_res
        emit soa_res
        emit aos_res
        return 0
