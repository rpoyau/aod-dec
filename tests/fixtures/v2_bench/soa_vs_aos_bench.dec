# SoA vs AoS exact integer layout benchmark (`PR 9`, Pillar 3):
# - Compares Structure-of-Arrays (`[int]` parallel lanes) against Array-of-Structures (`[CellPair]`)
#   over an identical exact recurrence, verifying 100% identical outputs with zero floats.
# - Comfortably fits within DEFAULT_FUEL = 100_000 for Exact VM, AOT, and ORC LLJIT parity.

struct CellPair:
    a: int
    b: int

Dec run_soa_kernel(n: int) -> int:
    mut lane_a = [1, 3, 5, 7, 11, 13, 17, 19]
    mut lane_b = [2, 4, 6, 8, 10, 12, 14, 16]
    mut acc = 0
    for step in 0..n:
        for j in 0..8:
            let va = lane_a[j]
            let vb = lane_b[j]
            let next_a = (va + vb + step) % 1000003
            let next_b = (vb + j + 1) % 1000003
            lane_a[j] = next_a
            lane_b[j] = next_b
            acc = (acc + next_a - next_b) % 1000000007
    return acc

Dec run_aos_kernel(n: int) -> int:
    mut pairs = [
        CellPair { a: 1, b: 2 },
        CellPair { a: 3, b: 4 },
        CellPair { a: 5, b: 6 },
        CellPair { a: 7, b: 8 },
        CellPair { a: 11, b: 10 },
        CellPair { a: 13, b: 12 },
        CellPair { a: 17, b: 14 },
        CellPair { a: 19, b: 16 }
    ]
    mut acc = 0
    for step in 0..n:
        for j in 0..8:
            let p = pairs[j]
            let next_a = (p.a + p.b + step) % 1000003
            let next_b = (p.b + j + 1) % 1000003
            pairs[j] = CellPair { a: next_a, b: next_b }
            acc = (acc + next_a - next_b) % 1000000007
    return acc

Dec main() -> int:
    let soa_res = run_soa_kernel(64)
    let aos_res = run_aos_kernel(64)
    assert soa_res == aos_res
    emit soa_res
    emit aos_res
    return 0
