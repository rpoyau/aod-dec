# SoA vs AoS exact integer layout benchmark (`PR 9`, Pillar 3):
# - Compares Structure-of-Arrays (`[int; 8]` parallel rank-lifted lanes) against Array-of-Structures
#   (`[CellPair; 8]`) over an identical exact recurrence, verifying 100% identical outputs with zero floats.

use aod::core:
    fold, range_seq

struct CellPair:
    a: int
    b: int

struct SoaState:
    lane_a: [int; 8]
    lane_b: [int; 8]
    acc: int

struct AosState:
    pairs: [CellPair; 8]
    acc: int

dec soa_step(st: SoaState, step: int) -> SoaState:
    let idx_plus_1 = [1, 2, 3, 4, 5, 6, 7, 8]
    let next_a = (st.lane_a + st.lane_b + step) % 1000003
    let next_b = (st.lane_b + idx_plus_1) % 1000003
    let delta = +/ (next_a - next_b)
    SoaState(next_a, next_b, (st.acc + delta) % 1000000007)

dec run_soa_kernel(n: int) -> int:
    let init = SoaState([1, 3, 5, 7, 11, 13, 17, 19], [2, 4, 6, 8, 10, 12, 14, 16], 0)
    let fin = fold(range_seq(0, n), init, soa_step)
    fin.acc

dec aos_pair_next(p: CellPair, step_and_j1: (int, int)) -> CellPair:
    let (step, j1) = step_and_j1
    CellPair((p.a + p.b + step) % 1000003, (p.b + j1) % 1000003)

dec aos_step(st: AosState, step: int) -> AosState:
    let ps = st.pairs
    let next_ps = [
        aos_pair_next(ps[0], (step, 1)),
        aos_pair_next(ps[1], (step, 2)),
        aos_pair_next(ps[2], (step, 3)),
        aos_pair_next(ps[3], (step, 4)),
        aos_pair_next(ps[4], (step, 5)),
        aos_pair_next(ps[5], (step, 6)),
        aos_pair_next(ps[6], (step, 7)),
        aos_pair_next(ps[7], (step, 8))
    ]
    let delta = (+/ next_ps.a) - (+/ next_ps.b)
    AosState(next_ps, (st.acc + delta) % 1000000007)

dec run_aos_kernel(n: int) -> int:
    let init = AosState(
        [
            CellPair(1, 2),
            CellPair(3, 4),
            CellPair(5, 6),
            CellPair(7, 8),
            CellPair(11, 10),
            CellPair(13, 12),
            CellPair(17, 14),
            CellPair(19, 16)
        ],
        0
    )
    let fin = fold(range_seq(0, n), init, aos_step)
    fin.acc

dec main() -> int:
    let soa_res = run_soa_kernel(64)
    let aos_res = run_aos_kernel(64)
    assert soa_res == aos_res
    emit soa_res
    emit aos_res
    0
