# Unboxed exact compute benchmark (`P0-4`, `P1-2`, `AC-05`, `AC-07`, `AC-15`):
# - Fits comfortably within DEFAULT_FUEL = 100_000 for Exact VM parity.
# - Exercises exact `int`, `t32`, and bounded-denominator `ratio` arithmetic via scalar-tuple
#   `evolve` whose `@dec_fn_*_unboxed` fast path stays 100% inline unboxed at LLVM -O2.

use aod::core:
    t32, ratio, evolve

dec unboxed_step:
    ((acc, tern, r): (int, t32, ratio), i: int) -> (int, t32, ratio):
        return (acc + (i % 17), tern + t32((i % 19) - 9), r + ratio(i % 15, 8))

dec run_unboxed_kernel:
    (n: int) -> int:
        let (acc, tern, r) = evolve((0, t32(0), 0/1r), 0..n, unboxed_step)
        emit acc
        emit tern
        emit r
        return 0

dec main:
    () -> int:
        return run_unboxed_kernel(3600)
