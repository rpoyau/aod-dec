# Unboxed exact compute benchmark (`P1-2`, `AC-05`, `AC-15`):
# - Fits comfortably within DEFAULT_FUEL = 100_000 for Exact VM parity.
# - Exercises exact 1-GPR Trit-Boxed `int` and 2-GPR `ratio` arithmetic in tight scalar `walk` loops
#   whose hot path stays 100% inline unboxed at LLVM -O2.

use aod::core::walk

dec step_int(acc: int) -> int:
    let next = (acc * 3 + 7) % 999983
    let w1 = int(b64(next))
    let w2 = int(b64(w1 + 1))
    int(b64(w2 - 1))

dec step_ratio(r: ratio) -> ratio:
    r + 3/8r

dec run_unboxed_kernel(n: int) -> int:
    let acc = walk(1, n, step_int)
    let rat = walk(0/1r, n, step_ratio)
    emit acc
    emit rat
    0

dec main() -> int:
    run_unboxed_kernel(2800)
