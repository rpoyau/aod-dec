# Native-scale exact Trit-Boxed loop benchmark for honest compile-inclusive amortization (`P0-4`, `AC-14`):
# - Runs 900,000 exact unboxed 2-bit balanced-ternary `int` iterations under `--fuel 2000000`.
# - At JIT -O0, unoptimized stack traffic + helper calls cost ~30-80 ms/run.
# - At JIT -O2, LLVM SROA + inlining runs the exact SWAR arithmetic in GPRs in ~2-5 ms/run,
#   genuinely amortizing real LLVM -O2 compile overhead across held-out runs.

use aod::core:
    select, walk

dec amortized_step(state: int) -> int:
    let nxt = (state * 1664525 + 1013904223) % 65536
    let hi = nxt + 3
    let lo = nxt + 1
    select((nxt % 2) == 1, hi, lo)

dec run_amortized_kernel(n: int) -> int:
    let out = walk(1337, n, amortized_step)
    emit out
    0

dec main() -> int:
    run_amortized_kernel(900000)
