# Native-scale exact unboxed loop benchmark for honest compile-inclusive amortization (`P0-4`, `AC-07`, `AC-14`):
# - Runs 900,000 exact unboxed `int` + `t32` iterations via scalar-tuple `evolve` under `--fuel 2000000`.
# - At JIT -O0, unoptimized stack traffic + inline helper calls cost ~30-60 ms/run.
# - At JIT -O2, LLVM SROA + inlining runs `@dec_fn_*_unboxed` in registers in ~1-3 ms/run,
#   genuinely amortizing real LLVM -O2 compile overhead across 8 held-out runs -> unfudged Retain!

use aod::core:
    t32, select, evolve

dec amortized_step:
    ((acc, tern, state): (int, t32, int), i: int) -> (int, t32, int):
        let next_state = (state * 1664525 + 1013904223) % 65536
        let chosen = select((next_state & 1) == 1, next_state, i)
        let next_acc = acc + chosen
        let next_tern = tern + t32((chosen % 19) - 9)
        return (next_acc, next_tern, next_state)

dec run_amortized_kernel:
    (n: int) -> int:
        let (acc, tern, _) = evolve((0, t32(0), 1337), 0..n, amortized_step)
        emit acc
        emit tern
        return 0

dec main:
    () -> int:
        return run_amortized_kernel(900000)
