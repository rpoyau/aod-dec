# Native-scale exact unboxed loop benchmark for honest compile-inclusive amortization (`P0-4`, `AC-14`):
# - Runs ~350,000 exact unboxed `int` + `t32` iterations under `--fuel 2000000`.
# - At JIT -O0, unoptimized stack traffic + inline helper calls cost ~30-60 ms/run.
# - At JIT -O2, LLVM SROA + inlining runs the exact same arithmetic in registers in ~1-3 ms/run,
#   genuinely amortizing real LLVM -O2 compile overhead across 8 held-out runs -> unfudged Retain!

Dec run_amortized_kernel(n: int) -> int:
    mut acc = 0
    mut tern = t32(0)
    mut state = 1337
    for i in 0..n:
        state = (state * 1664525 + 1013904223) % 65536
        let hi = state
        let lo = i
        mut chosen = 0
        if (state & 1) == 1:
            chosen = hi
        else:
            chosen = lo
        acc = acc + chosen
        tern = tern + t32((chosen % 19) - 9)
    emit acc
    emit tern
    return 0

Dec main() -> int:
    return run_amortized_kernel(900000)
