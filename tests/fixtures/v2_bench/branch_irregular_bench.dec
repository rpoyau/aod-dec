# Irregular branch selection benchmark (`P1-2`, `AC-15`):
# - Fits comfortably within DEFAULT_FUEL = 100_000 for Exact VM parity.
# - Both branch arms are pure `is_pure_select_safe` local identifiers (`hi` / `lo`), so
#   `CodegenPlan { branchless_select: true }` lowers to LLVM `select` while `false` lowers to `br i1`!

Dec run_irregular_select(n: int) -> int:
    mut state = 20261113
    mut acc = 0
    mut pick = 0
    for i in 0..n:
        state = (state * 1103515245 + 12345) % 2147483647
        let hi = i + 17
        let lo = i - 9
        if (state % 2) == 1:
            pick = hi
        else:
            pick = lo
        acc = acc + pick
    emit acc
    return 0

Dec main() -> int:
    return run_irregular_select(1500)
