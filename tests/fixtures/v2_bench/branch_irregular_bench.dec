# Irregular pseudo-random branch vs branchless select benchmark:
# - Fits comfortably within DEFAULT_FUEL = 100_000 for Exact VM parity.
# - Both `select` arms are pure `is_pure_select_safe` local identifiers (`hi` / `lo`), so
#   `CodegenPlan.branchless_select == true` lowers to LLVM `select` while `false` lowers to `br i1`.

use aod::core:
    select, walk

dec irregular_step(state: int) -> int:
    let nxt = (state * 1103515245 + 12345) % 2147483647
    let hi = nxt + 17
    let lo = nxt - 9
    select((nxt % 2) == 1, hi, lo)

dec run_irregular_select(n: int) -> int:
    let out = walk(20261113, n, irregular_step)
    emit out
    0

dec main() -> int:
    run_irregular_select(1500)
