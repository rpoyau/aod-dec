# Wave-Hardware Register Substrate Smoke Fixture (`null`, `b8`, `b64`, `int`, `bytes`,
# `[T; N]`, `0x`/`0b`, `q4` bitwise/Hamming, `superpose_cancel`, `select`, and audit helpers).

use aod::core
use aod::core:
    int, b8, b64, b64_bits, t1, q4, pack, unpack, bitnot, popcnt, is_hamming1, popcnt_xor,
    superpose_cancel, bytes, slice_bytes, concat_bytes, sha256_bytes, hex_bytes, array, array_set,
    select, len, map_put, verify_sheddic_route, verify_frg_cross_return
use aod::qext:
    ext_decimal, qext_render

const HEADER_MAGIC: [b8; 4] = [b8(0x41), b8(0x4F), b8(0x44), b8(0x32)]

struct WaveRegFrame:
    vac: null
    lanes: [b8; 4]
    word: b64
    phase9: int

enum GateSlot:
    Empty(null)
    Active(b64)

dec check_null:
    (null) -> int:
        1

dec check_gate:
    (GateSlot::Empty(null)) -> bool:
        true
    (GateSlot::Active(_)) -> bool:
        false

dec match_bytes:
    (b"AOD\x02") -> int:
        42
    (_: bytes) -> int:
        -1

dec sum_ro_frame(ro: ReadOnly<WaveRegFrame>) -> int:
    let ro_lanes: ReadOnly<[b8; 4]> = ro.lanes
    int(ro_lanes[0]) + int(ro_lanes[1]) + int(ro_lanes[2]) + int(ro_lanes[3]) + len(ro_lanes)

dec make_pair(a: b8, b: b8) -> [b8; 2]:
    [a, b]

dec main() -> int:
    # 1. Ontological Null (`null`)
    let z: null = null
    assert z == null
    assert check_null(z) == 1
    let g = GateSlot::Empty(null)
    assert check_gate(g)

    # 2. Exact `b8` bitwise/shifts & `int` arithmetic + hex/binary literals (`0x`, `0b`)
    let b_hi = b8(0xAA)
    let b_lo = b8(0b0101_0101)
    assert (b_hi ^ b_lo) == b8(0xFF)
    assert (b_hi & b_lo) == b8(0)
    assert (200 // 7) == 28 and (200 % 7) == 4
    assert (6 / 8) == 3/4r
    assert (b8(0b0001_0101) << 2) == b8(0b0101_0100)
    assert (b8(0x80) >> 7) == b8(1)

    # 3. Exact 64-bit register word `b64` + 32-trit `int` packed lane round-trip
    let w0 = b64_bits(0xAAAA_AAAA_AAAA_AAAA)
    assert popcnt(w0) == 32
    assert bitnot(b64_bits(0)) == b64_bits(0xFFFF_FFFF_FFFF_FFFF)
    assert ~b64_bits(0) == b64_bits(0xFFFF_FFFF_FFFF_FFFF)
    assert (b64_bits(1) << 63) > b64_bits(0x7FFF_FFFF_FFFF_FFFF)
    let all_neg = int(w0)
    assert b64(all_neg) == w0
    assert int(b64(-926510094425920)) == -926510094425920

    # 4. Balanced 9-trit range [-9841, +9841] in Trit-Boxed `int` + Euclidean floor div/mod
    let p_max = 9841
    let p_min = -p_max
    assert p_min == -9841
    assert unpack(pack(p_max)) == p_max
    assert int(b64(p_min)) == p_min
    assert (-7 // 3) == -3 and (-7 % 3) == 2

    # 5. Hypercube `q4` bitwise & Gray-code Hamming-1 adjacency + `superpose_cancel`
    let c0 = q4(0b0101)
    let c1 = q4(0b0111)
    assert (c0 ^ c1) == q4(0b0010) and is_hamming1(c0, c1)
    assert popcnt_xor(q4(0b0000), q4(0b1111)) == 4
    assert superpose_cancel(1t, -1t) == 0t
    assert superpose_cancel(1t, 1t) == 1t
    let wave_pos = 1 + 3 + 9
    let wave_neg = -1 + 3 - 27
    assert superpose_cancel(wave_pos, wave_neg) == -15

    # 6. Exact immutable `bytes` (`b"..."`, LE `b64`, `addr8`, SHA-256, hex)
    let raw = b"AOD\x02"
    assert len(raw) == 4 and raw[0] == b8(65) and raw[3] == b8(2)
    assert match_bytes(raw) == 42
    assert bytes([b8(65), b8(79), b8(68), b8(2)]) == raw
    assert concat_bytes(slice_bytes(raw, 0, 3), b"\x02") == raw
    assert bytes(b64_bits(0x0102030405060708)) == b"\x08\x07\x06\x05\x04\x03\x02\x01"
    assert bytes(00_8) == b"00_8"
    let abc_sha_hex = hex_bytes(sha256_bytes(b"abc"))
    assert abc_sha_hex == b"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"

    # 7. Fixed-size `[T; N]`, copy-on-write `array_set`, `ReadOnly` & `map` key
    let a0 = HEADER_MAGIC
    let a1 = array_set(a0, 3, b8(0x39))
    assert a0[3] == b8(0x32) and a1[3] == b8(0x39)
    assert array(10, 20, 30)[1] == 20
    let frame = WaveRegFrame(null, [b8(1), b8(2), b8(3), b8(4)], w0, 81)
    assert sum_ro_frame(frame) == 14
    let lut0: map[[b8; 2], int] = map[([b8(1), b8(2)], 12)]
    let lut = map_put(lut0, make_pair(b8(3), b8(4)), 34)
    assert aod::core::contains(lut, [b8(3), b8(4)]) and lut[[b8(1), b8(2)]] == 12

    # 8. Polymorphic branchless `select` (unqualified, `aod::core::select`, `core::select`, and `Q_ext`)
    let s1 = select(true, 27, -27)
    let s2 = aod::core::select(false, [b8(9), b8(9)], make_pair(b8(5), b8(6)))
    let s3 = core::select(true, b"ok", b"no")
    assert s1 == 27 and s2 == array(b8(5), b8(6)) and s3 == b"ok"

    # 9. Sheddic enclosure route & FRG cross-return identity helpers
    assert verify_sheddic_route(3, b8(6))
    assert not verify_sheddic_route(3, b8(7))
    assert verify_frg_cross_return(65536, 65600, 64)
    assert not verify_frg_cross_return(65536, 65600, 63)

    quarantine Q_ext:
        let qa = ext_decimal(b"1.25")
        let qb = ext_decimal(b"2.50")
        let qsel = select(true, qb, qa)
        emit qext_render(qsel)

    emit z
    emit b_hi ^ b_lo
    emit w0
    emit p_max
    emit superpose_cancel(wave_pos, wave_neg)
    emit raw
    emit a1
    emit abc_sha_hex
    0
