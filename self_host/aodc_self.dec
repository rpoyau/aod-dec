dec build_rt_bytes_from_list() -> bytes:
    # rdi = list_of_b8
    let step = join_bytes([
        b3(0x48, 0x89, 0xD9),
        b4(0x48, 0xC1, 0xE1, 0x03),
        b3(0x48, 0x01, 0xE9),
        b4(0x48, 0x8B, 0x49, 0x08),
        b3(0x48, 0x89, 0xC2),
        b3(0x48, 0x01, 0xDA),
