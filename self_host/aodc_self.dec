        b4(0x48, 0x8B, 0x0C, 0x24),
        b3(0x48, 0x89, 0xDA),
        b4(0x48, 0xC1, 0xE2, 0x03),
        b3(0x48, 0x01, 0xD1),
        b4(0x48, 0x89, 0x41, 0x08),
        b3(0x48, 0xFF, 0xC3),
    ])
    let hdr = b4(0x48, 0x3B, 0x5D, 0x00)
    let lp = cb2(hdr, jae_over(cb2(step, jmp_back(len(hdr) + 6 + len(step)))))
    join_bytes([
