        b3(0x48, 0xFF, 0xC3),
    ])
    let hdr = b4(0x48, 0x3B, 0x5D, 0x00)
    let lp = cb2(hdr, jae_over(cb2(step, jmp_back(len(hdr) + 6 + len(step)))))
    join_bytes([
        b4(0x55, 0x53, 0x41, 0x54),
        b3(0x48, 0x89, 0xFD),
        b3(0x48, 0x89, 0xF0),
        b3(0x49, 0x89, 0xD4),
        b2(0x31, 0xDB),
        lp,
        b5(0x41, 0x5C, 0x5B, 0x5D, 0xC3),
    ])

dec build_rt_each() -> bytes:
    let step = join_bytes([
        b3(0x48, 0x89, 0xD8),
        b4(0x48, 0xC1, 0xE0, 0x03),
        b3(0x48, 0x01, 0xE8),
        b4(0x48, 0x8B, 0x78, 0x08),
