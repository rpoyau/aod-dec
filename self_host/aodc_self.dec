dec build_rt_range_seq() -> bytes:
    # rdi = start, rsi = end
    let empty_clamp = b2(0x31, 0xED)
    let step = join_bytes([
        b3(0x48, 0x89, 0xC2),
        b3(0x48, 0x89, 0xDF),
        b4(0x48, 0xC1, 0xE7, 0x03),
        b3(0x48, 0x01, 0xFA),
        b4(0x49, 0x8D, 0x0C, 0x1C),
        b4(0x48, 0x89, 0x4A, 0x08),
        b3(0x48, 0xFF, 0xC3),
    ])
    let hdr = b3(0x48, 0x39, 0xEB)
    let lp = cb2(hdr, jae_over(cb2(step, jmp_back(len(hdr) + 6 + len(step)))))
    join_bytes([
        b4(0x55, 0x53, 0x41, 0x54),
        b3(0x49, 0x89, 0xFC),
        b3(0x48, 0x89, 0xF5),
        b3(0x4C, 0x29, 0xE5),
        jge_over(empty_clamp),
        b3(0x48, 0x89, 0xEF),
        b4(0x48, 0xC1, 0xE7, 0x03),
        b4(0x48, 0x83, 0xC7, 0x08),
        call_rt(RT_ALLOC),
        b3(0x48, 0x89, 0x28),
        b2(0x31, 0xDB),
        lp,
        b5(0x41, 0x5C, 0x5B, 0x5D, 0xC3),
    ])

dec build_rt_sum_seq() -> bytes:
    let step = join_bytes([
        b3(0x48, 0x89, 0xCA),
        b4(0x48, 0xC1, 0xE2, 0x03),
        b3(0x48, 0x01, 0xFA),
        b4(0x48, 0x03, 0x42, 0x08),
        b3(0x48, 0xFF, 0xC1),
    ])
    let hdr = b3(0x48, 0x3B, 0x0F)
    let lp = cb2(hdr, jae_over(cb2(step, jmp_back(len(hdr) + 6 + len(step)))))
    cb4(b2(0x31, 0xC0), b2(0x31, 0xC9), lp, b1(0xC3))

dec build_rt_walk() -> bytes:
    let step = cb3(b3(0x48, 0x89, 0xC7), b3(0x41, 0xFF, 0xD4), b3(0x48, 0xFF, 0xCB))
    let hdr = b3(0x48, 0x85, 0xDB)
    let lp = cb2(hdr, jz_over(cb2(step, jmp_back(len(hdr) + 6 + len(step)))))
    join_bytes([
        b3(0x48, 0x85, 0xF6),
        jns_over(call_rt(RT_ASSERT_FAIL)),
        b4(0x55, 0x53, 0x41, 0x54),
        b3(0x48, 0x89, 0xF8),
        b3(0x48, 0x89, 0xF3),
        b3(0x49, 0x89, 0xD4),
        lp,
        b5(0x41, 0x5C, 0x5B, 0x5D, 0xC3),
    ])

dec build_rt_settle() -> bytes:
    let chk_fuel = cb2(b3(0x48, 0x85, 0xDB), jnz_over(call_rt(RT_ASSERT_FAIL)))
    let call_step = join_bytes([
        b3(0x48, 0x89, 0xC5),
        b3(0x48, 0x89, 0xC7),
        b3(0x41, 0xFF, 0xD4),
        b3(0x48, 0xFF, 0xCB),
        b3(0x48, 0x39, 0xE8),
    ])
    let pre_len = len(chk_fuel) + len(call_step)
    let lp = cb3(chk_fuel, call_step, jz_over(jmp_back(pre_len + 6)))
    join_bytes([
        b3(0x48, 0x85, 0xF6),
        jns_over(call_rt(RT_ASSERT_FAIL)),
        b4(0x55, 0x53, 0x41, 0x54),
        b3(0x48, 0x89, 0xF8),
        b3(0x48, 0x89, 0xF3),
        b3(0x49, 0x89, 0xD4),
        lp,
        b5(0x41, 0x5C, 0x5B, 0x5D, 0xC3),
    ])

dec build_rt_fold() -> bytes:
    let step = join_bytes([
        b3(0x48, 0x89, 0xC7),
        b3(0x48, 0x89, 0xDA),
        b4(0x48, 0xC1, 0xE2, 0x03),
        b3(0x48, 0x01, 0xEA),
        b4(0x48, 0x8B, 0x72, 0x08),
