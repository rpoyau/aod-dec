# Alpha-Omega Dynamics (AOD) Clean-Break Self-Hosting Compiler (aodc_self.dec)
# Compiles clean-break Dec source directly to standalone static libc-free Linux x86-64 ELF64.
# Fixed-point contract: Stage0 -> stage1 -> stage2 -> stage3 with SHA256(stage2) == SHA256(stage3).

use aod::sys:
    cli_args, read_file_bytes, write_executable_elf

# ============================================================================
# Section 1: Token, Type, & ELF64 Virtual Address Constants
# ============================================================================

const TK_EOF: int = 0
const TK_NEWLINE: int = 1
const TK_INDENT: int = 2
const TK_DEDENT: int = 3
const TK_IDENT: int = 4
const TK_INT: int = 5
const TK_OCTAL: int = 6
const TK_TRIT: int = 7
const TK_STR: int = 8
const TK_BOOL: int = 9

const TK_STRUCT: int = 10
const TK_CONST: int = 11
const TK_DEC: int = 12
const TK_USE: int = 13
const TK_LET: int = 14
const TK_ASSERT: int = 15
const TK_EMIT: int = 16
const TK_WHERE: int = 17
const TK_AND: int = 18
const TK_OR: int = 19
const TK_NOT: int = 20

const TK_LPAREN: int = 30
const TK_RPAREN: int = 31
const TK_LBRACKET: int = 32
const TK_RBRACKET: int = 33
const TK_COMMA: int = 34
const TK_COLON: int = 35
const TK_DOT: int = 36
const TK_ARROW: int = 37
const TK_ASSIGN: int = 38
const TK_PIPE_GT: int = 39
const TK_SUM_ADV: int = 40

const TK_PLUS: int = 50
const TK_MINUS: int = 51
const TK_STAR: int = 52
const TK_FLOORDIV: int = 53
const TK_PERCENT: int = 54
const TK_SHL: int = 55
const TK_SHR: int = 56
const TK_AMP: int = 57
const TK_CARET: int = 58
const TK_BAR: int = 59
const TK_TILDE: int = 60
const TK_EQ: int = 61
const TK_NE: int = 62
const TK_LT: int = 63
const TK_LE: int = 64
const TK_GT: int = 65
const TK_GE: int = 66
const TK_CMP: int = 67
const TK_DCOLON: int = 68

const TY_UNIT: int = 0
const TY_INT: int = 1
const TY_BOOL: int = 2
const TY_T1: int = 3
const TY_B8: int = 4
const TY_B64: int = 5
const TY_BYTES: int = 6
const TY_STR: int = 7
const TY_ADDR8: int = 8
const TY_STRUCT_BASE: int = 100
const TY_FN_BASE: int = 1000
const TY_LIST_BASE: int = 10000

const ELF_BASE_VADDR: int = 0x00400000
const ELF_ENTRY_VADDR: int = 0x00400078
const RT_TABLE_VADDR: int = 0x00400F00
const FN_TABLE_VADDR: int = 0x00401000

const RT_ALLOC: int = 0
const RT_CLI_ARGS: int = 1
const RT_READ_FILE: int = 2
const RT_WRITE_ELF: int = 3
const RT_DIV_FLOOR: int = 4
const RT_REM_FLOOR: int = 5
const RT_BYTES_EQ: int = 6
const RT_PUSH_BYTE: int = 7
const RT_CONCAT_BYTES: int = 8
const RT_SLICE_BYTES: int = 9
const RT_LE_BYTES: int = 10
const RT_BYTES_FROM_LIST: int = 11
const RT_SEQ_GET: int = 12
const RT_BYTES_GET: int = 13
const RT_SEQ_PUSH: int = 14
const RT_SEQ_CONCAT: int = 15
const RT_SEQ_SLICE: int = 16
const RT_SEQ_SET_AT: int = 17
const RT_RANGE_SEQ: int = 18
const RT_SUM_SEQ: int = 19
const RT_WALK: int = 20
const RT_SETTLE: int = 21
const RT_FOLD: int = 22
const RT_EACH: int = 23
const RT_EMIT_INT: int = 24
const RT_EMIT_STR: int = 25
const RT_EMIT_BOOL: int = 26
const RT_EMIT_T1: int = 27
const RT_ASSERT_FAIL: int = 28
const RT_PACK_TRIT32: int = 29
const RT_UNPACK_TRIT32: int = 30

# ============================================================================
# Section 2: Compiler Data Structures
# ============================================================================

struct TopBlock:
    kind: int
    start: int
    end_pos: int

struct Tok:
    kind: int
    val: int
    text: bytes

struct LexState:
    src: bytes
    pos: int
    limit: int
    at_bol: int
    paren_depth: int
    indents: [int]
    toks: [Tok]

struct StructDef:
    name: bytes
    field_names: [bytes]
    field_tys: [int]

struct ConstDef:
    name: bytes
    val: int
    str_val: bytes
    ty: int

struct FnSig:
    name: bytes
    param_tys: [int]
    ret_ty: int
    blk_start: int
    blk_end: int

struct SymTab:
    structs: [StructDef]
    consts: [ConstDef]
    fns: [FnSig]

struct LocalVar:
    name: bytes
    slot: int
    ty: int

struct CgEnv:
    sym: SymTab
    toks: [Tok]
    locals: [LocalVar]
    next_slot: int
    ret_ty: int

struct ExprOut:
    pos: int
    ty: int
    max_slot: int
    code: bytes

struct StmtOut:
    pos: int
    env: CgEnv
    is_tail: int
    code: bytes

struct ArmOut:
    pos: int
    max_slot: int
    code: bytes

# ============================================================================
# Section 3: Balanced Byte & Sequence Combinators
# ============================================================================

dec b1(a: int) -> bytes:
    bytes([b8(a)])

dec b2(a: int, b: int) -> bytes:
    bytes([b8(a), b8(b)])

dec b3(a: int, b: int, c: int) -> bytes:
    bytes([b8(a), b8(b), b8(c)])

dec b4(a: int, b: int, c: int, d: int) -> bytes:
    bytes([b8(a), b8(b), b8(c), b8(d)])

dec b5(a: int, b: int, c: int, d: int, e: int) -> bytes:
    bytes([b8(a), b8(b), b8(c), b8(d), b8(e)])

dec cb2(a: bytes, b: bytes) -> bytes:
    concat_bytes(a, b)

dec cb3(a: bytes, b: bytes, c: bytes) -> bytes:
    concat_bytes(concat_bytes(a, b), c)

dec cb4(a: bytes, b: bytes, c: bytes, d: bytes) -> bytes:
    concat_bytes(concat_bytes(a, b), concat_bytes(c, d))

dec cb5(a: bytes, b: bytes, c: bytes, d: bytes, e: bytes) -> bytes:
    concat_bytes(cb3(a, b, c), concat_bytes(d, e))

dec merge_pairs_step(chunks: [bytes], idx: int, n: int, acc: [bytes]) -> [bytes]:
    select(
        idx >= n,
        acc,
        select(
            idx + 1 < n,
            merge_pairs_step(chunks, idx + 2, n, push(acc, concat_bytes(chunks[idx], chunks[idx + 1]))),
            push(acc, chunks[idx]),
        ),
    )

dec join_bytes(chunks: [bytes]) -> bytes:
    let n = len(chunks)
    select(
        n == 0,
        bytes(""),
        select(
            n == 1,
            chunks[0],
            join_bytes(merge_pairs_step(chunks, 0, n, [])),
        ),
    )

dec dup_bytes(x: bytes) -> bytes:
    cb2(x, x)

dec make_nops(n: int) -> bytes:
    select(
        n <= 0,
        bytes(""),
        select(
            n == 1,
            b1(0x90),
            select(
                (n % 2) == 0,
                dup_bytes(make_nops(n // 2)),
                cb2(b1(0x90), make_nops(n - 1)),
            ),
        ),
    )

# ============================================================================
# Section 4: x86-64 Instruction Encoders
# ============================================================================

dec jz_over(body: bytes) -> bytes:
    cb3(b2(0x0F, 0x84), i32_le_bytes(len(body)), body)

dec jnz_over(body: bytes) -> bytes:
    cb3(b2(0x0F, 0x85), i32_le_bytes(len(body)), body)

dec jb_over(body: bytes) -> bytes:
    cb3(b2(0x0F, 0x82), i32_le_bytes(len(body)), body)

dec jae_over(body: bytes) -> bytes:
    cb3(b2(0x0F, 0x83), i32_le_bytes(len(body)), body)

dec ja_over(body: bytes) -> bytes:
    cb3(b2(0x0F, 0x87), i32_le_bytes(len(body)), body)

dec jbe_over(body: bytes) -> bytes:
    cb3(b2(0x0F, 0x86), i32_le_bytes(len(body)), body)

dec jl_over(body: bytes) -> bytes:
    cb3(b2(0x0F, 0x8C), i32_le_bytes(len(body)), body)

dec jge_over(body: bytes) -> bytes:
    cb3(b2(0x0F, 0x8D), i32_le_bytes(len(body)), body)

dec jle_over(body: bytes) -> bytes:
    cb3(b2(0x0F, 0x8E), i32_le_bytes(len(body)), body)

dec jns_over(body: bytes) -> bytes:
    cb3(b2(0x0F, 0x89), i32_le_bytes(len(body)), body)

dec jmp_over(body: bytes) -> bytes:
    cb3(b1(0xE9), i32_le_bytes(len(body)), body)

dec jmp_rel(dist: int) -> bytes:
    cb2(b1(0xE9), i32_le_bytes(dist))

dec if_nz_else(then_code: bytes, else_code: bytes) -> bytes:
    let then_and_jmp = cb2(then_code, jmp_rel(len(else_code)))
    cb2(jz_over(then_and_jmp), else_code)

dec if_eq_else(then_code: bytes, else_code: bytes) -> bytes:
    let then_and_jmp = cb2(then_code, jmp_rel(len(else_code)))
    cb2(jnz_over(then_and_jmp), else_code)

dec jmp_back(body_len: int) -> bytes:
    cb2(b1(0xE9), i32_le_bytes(0 - (body_len + 5)))

dec call_rt(slot: int) -> bytes:
    cb3(b1(0xB8), u32_le_bytes(RT_TABLE_VADDR + slot * 8), b2(0xFF, 0x10))

dec call_fn(fn_idx: int) -> bytes:
    cb3(b1(0xB8), u32_le_bytes(FN_TABLE_VADDR + fn_idx * 8), b2(0xFF, 0x10))

dec load_fn_ptr_rax(fn_idx: int) -> bytes:
    cb3(b1(0xB8), u32_le_bytes(FN_TABLE_VADDR + fn_idx * 8), b3(0x48, 0x8B, 0x00))

dec mov_rax_imm64(v: int) -> bytes:
    cb2(b2(0x48, 0xB8), i64_le_bytes(v))

dec mov_rcx_imm64(v: int) -> bytes:
    cb2(b2(0x48, 0xB9), i64_le_bytes(v))

dec load_slot_rax(slot: int) -> bytes:
    cb2(b3(0x48, 0x8B, 0x85), i32_le_bytes(0 - 8 * (slot + 1)))

dec store_slot_rax(slot: int) -> bytes:
    cb2(b3(0x48, 0x89, 0x85), i32_le_bytes(0 - 8 * (slot + 1)))

dec store_arg_reg(idx: int) -> bytes:
    let disp = i32_le_bytes(0 - 8 * (idx + 1))
    select(
        idx == 0,
        cb2(b3(0x48, 0x89, 0xBD), disp),
        select(
            idx == 1,
            cb2(b3(0x48, 0x89, 0xB5), disp),
            select(
                idx == 2,
                cb2(b3(0x48, 0x89, 0x95), disp),
                select(
                    idx == 3,
                    cb2(b3(0x48, 0x89, 0x8D), disp),
                    select(
                        idx == 4,
                        cb2(b3(0x4C, 0x89, 0x85), disp),
                        cb2(b3(0x4C, 0x89, 0x8D), disp),
                    ),
                ),
            ),
        ),
    )

dec pop_arg_reg(idx: int) -> bytes:
    select(
        idx == 0,
        b1(0x5F),
        select(
            idx == 1,
            b1(0x5E),
            select(
                idx == 2,
                b1(0x5A),
                select(
                    idx == 3,
                    b1(0x59),
                    select(idx == 4, b2(0x41, 0x58), b2(0x41, 0x59)),
                ),
            ),
        ),
    )

dec emit_inline_bytes_lit(payload: bytes) -> bytes:
    let n = len(payload)
    cb4(
        bytes([b8(0x48), b8(0x8D), b8(0x05), b8(5), b8(0), b8(0), b8(0)]),
        cb2(b1(0xE9), i32_le_bytes(8 + n)),
        i64_le_bytes(n),
        payload,
    )

# ============================================================================
# Section 5: Libc-Free Linux x86-64 Runtime Helpers & ELF64 Image Builder
# ============================================================================

dec build_rt_assert_fail() -> bytes:
    let msg = bytes("aodc: AssertionFailed\n")
    cb5(
        bytes([b8(0x48), b8(0x8D), b8(0x35), b8(5), b8(0), b8(0), b8(0)]),
        jmp_over(msg),
        cb3(b5(0xBF, 2, 0, 0, 0), b5(0xBA, 22, 0, 0, 0), b5(0xB8, 1, 0, 0, 0)),
        b2(0x0F, 0x05),
        cb3(b5(0xBF, 1, 0, 0, 0), b5(0xB8, 60, 0, 0, 0), b2(0x0F, 0x05)),
    )

dec build_rt_alloc() -> bytes:
    let fast_ret = cb3(b3(0x4C, 0x89, 0xF8), b3(0x49, 0x01, 0xFF), b1(0xC3))
    let save_regs = bytes([b8(0x57), b8(0x56), b8(0x52), b8(0x51), b8(0x41), b8(0x50), b8(0x41), b8(0x51)])
    let rest_regs = bytes([b8(0x41), b8(0x59), b8(0x41), b8(0x58), b8(0x59), b8(0x5A), b8(0x5E), b8(0x5F)])
    let mmap_call = join_bytes([
        save_regs,
        b3(0x48, 0x89, 0xFE),
        bytes([b8(0x48), b8(0x81), b8(0xC6), b8(0x00), b8(0x00), b8(0x00), b8(0x10)]),
        b2(0x31, 0xFF),
        b5(0xBA, 3, 0, 0, 0),
        bytes([b8(0x41), b8(0xBA), b8(0x22), b8(0), b8(0), b8(0)]),
        bytes([b8(0x49), b8(0xC7), b8(0xC0), b8(0xFF), b8(0xFF), b8(0xFF), b8(0xFF)]),
        b3(0x45, 0x31, 0xC9),
        b5(0xB8, 9, 0, 0, 0),
        b2(0x0F, 0x05),
        bytes([b8(0x48), b8(0x3D), b8(0x01), b8(0xF0), b8(0xFF), b8(0xFF)]),
        jb_over(call_rt(RT_ASSERT_FAIL)),
        b3(0x49, 0x89, 0xC7),
        bytes([b8(0x4C), b8(0x8D), b8(0x34), b8(0x30)]),
        rest_regs,
        fast_ret,
    ])
    join_bytes([
        b4(0x48, 0x83, 0xC7, 0x07),
        b4(0x48, 0x83, 0xE7, 0xF8),
        b3(0x48, 0x85, 0xFF),
        jnz_over(b4(0x48, 0x83, 0xC7, 0x08)),
        b4(0x49, 0x8D, 0x04, 0x3F),
        b3(0x4C, 0x39, 0xF0),
        ja_over(fast_ret),
        mmap_call,
    ])

dec build_rt_cli_args() -> bytes:
    b4(0x4C, 0x89, 0xE8, 0xC3)

dec build_cstr_from_rdi() -> bytes:
    # rdi = bytes_ptr -> rax = nul-terminated char* (clobbers rcx, rdx, rsi, rdi)
    join_bytes([
        b3(0x48, 0x8B, 0x0F),
        b3(0x48, 0x85, 0xC9),
        jnz_over(call_rt(RT_ASSERT_FAIL)),
        b1(0x57),
        b4(0x48, 0x8D, 0x79, 0x09),
        call_rt(RT_ALLOC),
        b1(0x5E),
        b3(0x48, 0x8B, 0x0E),
        b4(0x48, 0x83, 0xC6, 0x08),
        b3(0x48, 0x89, 0xC2),
        b3(0x48, 0x89, 0xC7),
        b2(0xF3, 0xA4),
        b3(0xC6, 0x07, 0x00),
        b3(0x48, 0x89, 0xD0),
    ])

dec build_rt_read_file() -> bytes:
    let read_call = join_bytes([
        b3(0x48, 0x89, 0xDF),
        b3(0x4C, 0x89, 0xFE),
        b5(0xBA, 0x00, 0x00, 0x01, 0x00),
        b2(0x31, 0xC0),
        b2(0x0F, 0x05),
        b3(0x48, 0x85, 0xC0),
        jns_over(call_rt(RT_ASSERT_FAIL)),
        b3(0x48, 0x85, 0xC0),
    ])
    let adv = b3(0x49, 0x01, 0xC7)
    let loop_tail = jz_over(cb2(adv, jmp_back(len(read_call) + 6 + len(adv))))
    join_bytes([
        b4(0x55, 0x53, 0x41, 0x54),
        build_cstr_from_rdi(),
        b3(0x48, 0x89, 0xC7),
        b2(0x31, 0xF6),
        b2(0x31, 0xD2),
        b5(0xB8, 2, 0, 0, 0),
        b2(0x0F, 0x05),
        b3(0x48, 0x85, 0xC0),
        jns_over(call_rt(RT_ASSERT_FAIL)),
        b3(0x48, 0x89, 0xC3),
        b5(0xBF, 0x10, 0x00, 0x40, 0x00),
        call_rt(RT_ALLOC),
        b3(0x48, 0x89, 0xC5),
        b4(0x4C, 0x8D, 0x7D, 0x08),
        read_call,
        loop_tail,
        b3(0x48, 0x89, 0xDF),
        b5(0xB8, 3, 0, 0, 0),
        b2(0x0F, 0x05),
        b3(0x4C, 0x89, 0xF8),
        b4(0x48, 0x8D, 0x4D, 0x08),
        b3(0x48, 0x29, 0xC8),
        b4(0x48, 0x89, 0x45, 0x00),
        b4(0x49, 0x83, 0xC7, 0x07),
        b4(0x49, 0x83, 0xE7, 0xF8),
        b3(0x48, 0x89, 0xE8),
        b5(0x41, 0x5C, 0x5B, 0x5D, 0xC3),
    ])

dec build_rt_write_elf() -> bytes:
    let wr_step = join_bytes([
        b3(0x48, 0x89, 0xDF),
        b3(0x48, 0x89, 0xEE),
        b3(0x4C, 0x89, 0xE2),
        b5(0xB8, 1, 0, 0, 0),
        b2(0x0F, 0x05),
        b3(0x48, 0x85, 0xC0),
        jns_over(call_rt(RT_ASSERT_FAIL)),
        b3(0x48, 0x01, 0xC5),
        b3(0x49, 0x29, 0xC4),
    ])
    let wr_hdr = b3(0x4D, 0x85, 0xE4)
    let wr_loop = cb2(wr_hdr, jz_over(cb2(wr_step, jmp_back(len(wr_hdr) + 6 + len(wr_step)))))
    join_bytes([
        b4(0x55, 0x53, 0x41, 0x54),
        b3(0x49, 0x89, 0xF4),
        b5(0x49, 0x83, 0x3C, 0x24, 0x40),
        jae_over(call_rt(RT_ASSERT_FAIL)),
        bytes([b8(0x41), b8(0x81), b8(0x7C), b8(0x24), b8(0x08), b8(0x7F), b8(0x45), b8(0x4C), b8(0x46)]),
        jz_over(call_rt(RT_ASSERT_FAIL)),
        build_cstr_from_rdi(),
        b3(0x48, 0x89, 0xC7),
        b5(0xBE, 0x41, 0x02, 0x00, 0x00),
        b5(0xBA, 0xED, 0x01, 0x00, 0x00),
        b5(0xB8, 2, 0, 0, 0),
        b2(0x0F, 0x05),
        b3(0x48, 0x85, 0xC0),
        jns_over(call_rt(RT_ASSERT_FAIL)),
        b3(0x48, 0x89, 0xC3),
        b5(0x49, 0x8D, 0x6C, 0x24, 0x08),
        b4(0x4D, 0x8B, 0x24, 0x24),
        b2(0x41, 0x54),
        wr_loop,
        b3(0x48, 0x89, 0xDF),
        b5(0xBE, 0xED, 0x01, 0x00, 0x00),
        b5(0xB8, 91, 0, 0, 0),
        b2(0x0F, 0x05),
        b3(0x48, 0x89, 0xDF),
        b5(0xB8, 3, 0, 0, 0),
        b2(0x0F, 0x05),
        b1(0x58),
        b5(0x41, 0x5C, 0x5B, 0x5D, 0xC3),
    ])

dec build_rt_div_rem_floor(is_rem: int) -> bytes:
    let adj = cb2(b3(0x48, 0xFF, 0xC8), b3(0x48, 0x01, 0xF2))
    let chk_opp = cb3(b3(0x48, 0x89, 0xD1), b3(0x48, 0x31, 0xF1), jns_over(adj))
    let tail = select(is_rem == 1, b4(0x48, 0x89, 0xD0, 0xC3), b1(0xC3))
    join_bytes([
        b3(0x48, 0x85, 0xF6),
        jnz_over(call_rt(RT_ASSERT_FAIL)),
        b3(0x48, 0x89, 0xF8),
        b2(0x48, 0x99),
        b3(0x48, 0xF7, 0xFE),
        b3(0x48, 0x85, 0xD2),
        jz_over(chk_opp),
        tail,
    ])

dec build_rt_bytes_eq() -> bytes:
    let ret0 = cb2(b2(0x31, 0xC0), b1(0xC3))
    let ret1 = cb2(b5(0xB8, 1, 0, 0, 0), b1(0xC3))
    join_bytes([
        b3(0x48, 0x8B, 0x0F),
        b3(0x48, 0x3B, 0x0E),
        jz_over(ret0),
        b3(0x48, 0x85, 0xC9),
        jnz_over(ret1),
        b4(0x48, 0x83, 0xC7, 0x08),
        b4(0x48, 0x83, 0xC6, 0x08),
        b2(0xF3, 0xA6),
        b3(0x0F, 0x94, 0xC0),
        b3(0x0F, 0xB6, 0xC0),
        b1(0xC3),
    ])

dec build_rt_push_byte() -> bytes:
    join_bytes([
        b4(0x55, 0x53, 0x41, 0x54),
        b3(0x49, 0x89, 0xFC),
        b3(0x48, 0x89, 0xF3),
        b4(0x49, 0x8B, 0x2C, 0x24),
        b4(0x48, 0x8D, 0x7D, 0x09),
        call_rt(RT_ALLOC),
        b3(0x48, 0x89, 0xC2),
        b4(0x48, 0x8D, 0x4D, 0x01),
        b3(0x48, 0x89, 0x0A),
        b3(0x48, 0x89, 0xE9),
        b5(0x49, 0x8D, 0x74, 0x24, 0x08),
        b4(0x48, 0x8D, 0x7A, 0x08),
        b2(0xF3, 0xA4),
        b2(0x88, 0x1F),
        b3(0x48, 0x89, 0xD0),
        b5(0x41, 0x5C, 0x5B, 0x5D, 0xC3),
    ])

dec build_rt_concat_bytes() -> bytes:
    join_bytes([
        b4(0x55, 0x53, 0x41, 0x54),
        b3(0x49, 0x89, 0xFC),
        b3(0x48, 0x89, 0xF3),
        b4(0x49, 0x8B, 0x2C, 0x24),
        b3(0x48, 0x03, 0x2B),
        b4(0x48, 0x8D, 0x7D, 0x08),
