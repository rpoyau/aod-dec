        b3(0x48, 0xFF, 0xC3),
    ])
    let hdr = b4(0x48, 0x3B, 0x5D, 0x00)
    let lp = cb2(hdr, jae_over(cb2(step, jmp_back(len(hdr) + 6 + len(step)))))
    join_bytes([
        b3(0x55, 0x53, 0x48),
        b2(0x89, 0xFD),
        b4(0x48, 0x8B, 0x7D, 0x00),
        b4(0x48, 0x83, 0xC7, 0x08),
        call_rt(RT_ALLOC),
        b4(0x48, 0x8B, 0x4D, 0x00),
        b3(0x48, 0x89, 0x08),
        b2(0x31, 0xDB),
        lp,
        b3(0x5B, 0x5D, 0xC3),
    ])

