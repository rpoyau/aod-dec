# Compiler input: exact occurrence classification, followed by exact host current assembly.
# mode 0 packs orientation and flags; mode 1 computes swept membership.
Dec coefficient(mode, left, right, available, kind) -> result:
    (int mode, int left, int right, int available, int kind) -> int result:
        assert mode == 0 or mode == 1
        assert left == 0 or left == 1
        assert right == 0 or right == 1
        assert available == 0 or available == 1
        assert kind >= 0 and kind <= 2
        int orientation = left - right
        int selected = 1 if available == 1 and orientation != 0 else 0
        int internal = 1 if left == 1 and right == 1 else 0
        int exterior = 1 if left == 0 and right == 0 else 0
        int inactive = 1 - available
        int bucket = kind + 1 if selected == 1 else 0
        result = orientation + 1 + 3 * selected + 6 * internal + 12 * exterior + 24 * inactive + 48 * bucket if mode == 0 else orientation

Dec main() -> result:
    () -> int result:
        result = coefficient(0, 1, 0, 1, 0)
