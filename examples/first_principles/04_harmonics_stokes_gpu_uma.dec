use aod::core:
    int, u8, t9, t32, ratio, max, select, evolve, verify_sheddic_route

struct CTrit:
    re: t32
    im: t32

struct HarmonicBin:
    chi_id: u8
    v_hat_re: ratio
    v_hat_im: ratio
    power_n: ratio
    c_standing: ratio
    s_standing: ratio

struct StokesAudit:
    s_int: t32
    s_div: t32
    s_bound: t32
    residual_e: t32
    valid_scope: u8

struct ShedRoutePkg:
    x_total: t32
    x_endo: t32
    x_exo: t32
    x_redir: t32
    x_open: t32
    sheddic_path: u8

struct DisomaUmaState:
    a_cpu_local: t32
    a_gpu_local: t32
    c_cross_12: t32
    a_enclosing: t32
    n_fields: t9

dec harmonic_acc_step:
    ((sum_re, sum_im): (t32, t32), g: int, (v_trace, chi_conj): (array[t32, 4], array[CTrit, 4])) -> (t32, t32):
        let v = v_trace[g]
        let ch = chi_conj[g]
        return ((sum_re + (v * ch.re)), (sum_im + (v * ch.im)))

dec eval_harmonic_bin4:
    (u8(1), chi_id: u8, v_trace: array[t32, 4], chi_conj: array[CTrit, 4]) -> HarmonicBin:
        let (sum_re, sum_im) = evolve((t32(0), t32(0)), 0..4, harmonic_acc_step, (v_trace, chi_conj))
        let re_hat = ratio(int(sum_re), 4)
        let im_hat = ratio(int(sum_im), 4)
        let pwr = ratio(int(((sum_re * sum_re) + (sum_im * sum_im))), 4)
        let c_st = ratio(int((t32(2) * sum_re)), 4)
        let s_st = ratio(int(-((t32(2) * sum_im))), 4)
        return HarmonicBin(chi_id, re_hat, im_hat, pwr, c_st, s_st)

dec audit_stokes_region:
    (phi_12: t32, phi_21: t32, phi_1_ext: t32, phi_2_ext: t32, div_1: t32, div_2: t32) -> StokesAudit:
        let s_int = (phi_12 + phi_21)
        let s_div = (div_1 + div_2)
        let s_bound = (phi_1_ext + phi_2_ext)
        let res_e = (s_div - s_bound)
        let is_valid = u8(((s_int == t32(0)) and (res_e == t32(0))))
        return StokesAudit(s_int, s_div, s_bound, res_e, is_valid)

dec route_hardware_surplus:
    (u8(1), p_burden: t32, c_close: t32, target_enclosure: u8) -> ShedRoutePkg:
        let x_shed = max(t32(0), (p_burden - c_close))
        let path = select((x_shed > t32(0)), target_enclosure, u8(0))
        assert verify_sheddic_route(int(x_shed), path)
        return ShedRoutePkg(x_shed, t32(0), x_shed, t32(0), t32(0), path)
    (u8(2), p_burden: t32, c_close: t32, target_enclosure: u8) -> ShedRoutePkg:
        let x_shed = max(t32(0), (p_burden - c_close))
        let path = select((x_shed > t32(0)), target_enclosure, u8(0))
        assert verify_sheddic_route(int(x_shed), path)
        let x_endo = (x_shed // t32(2))
        let x_redir = (x_shed - x_endo)
        return ShedRoutePkg(x_shed, x_endo, t32(0), x_redir, t32(0), path)

dec step_uma_disoma:
    (a_cpu: t32, a_gpu: t32, c_cross_12: t32, p_shared: t32) -> (DisomaUmaState, ratio, ratio, ratio):
        assert (p_shared > t32(0))
        let a_super = ((a_cpu + a_gpu) + c_cross_12)
        let uma = DisomaUmaState(a_cpu, a_gpu, c_cross_12, a_super, t9(2))
        return (uma, ratio(int(a_cpu), int(p_shared)), ratio(int(a_gpu), int(p_shared)), ratio(int(a_super), int(p_shared)))

dec main:
    () -> int:
        let v_trace: array[t32, 4] = [t32(2), t32(0), t32(-2), t32(0)]
        let chi_conj: array[CTrit, 4] = [CTrit(t32(1), t32(0)), CTrit(t32(0), t32(-1)), CTrit(t32(-1), t32(0)), CTrit(t32(0), t32(1))]
        let hbin = eval_harmonic_bin4(u8(1), u8(1), v_trace, chi_conj)
        assert ((((hbin.v_hat_re == 1/1r) and (hbin.v_hat_im == 0/1r)) and (hbin.power_n == 4/1r)) and (hbin.c_standing == 2/1r))
        let stokes = audit_stokes_region(t32(7), t32(-7), t32(5), t32(4), t32(3), t32(6))
        assert (((stokes.s_int == t32(0)) and (stokes.residual_e == t32(0))) and (stokes.valid_scope == u8(1)))
        let pcie = route_hardware_surplus(u8(1), t32(31), t32(24), u8(6))
        let uma_pkg = route_hardware_surplus(u8(2), t32(31), t32(24), u8(8))
        assert ((pcie.x_exo == t32(7)) and (pcie.x_endo == t32(0)))
        assert (((uma_pkg.x_endo == t32(3)) and (uma_pkg.x_redir == t32(4))) and (uma_pkg.sheddic_path == u8(8)))
        let (uma, j_cpu, j_gpu, j_super) = step_uma_disoma(t32(6), t32(9), t32(3), t32(12))
        assert ((((uma.a_enclosing == t32(18)) and (j_cpu == 1/2r)) and (j_gpu == 3/4r)) and (j_super == 3/2r))
        emit hbin.power_n
        emit stokes.valid_scope
        emit pcie.x_exo
        emit (uma_pkg.x_endo, uma_pkg.x_redir)
        emit j_super
        return 0
