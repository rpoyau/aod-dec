# AOD Manual §§5-6 — Boundary Currents, Double-Slit Cross-Return delta_3,
# Short-Window Clipping, Moving Boundary, and Stokes Cancellation
# Reference binding: rpoyau/aod@98ddfa0 (03_short_window_rcd_shedding_fixtures.tex,
#                                        04_boundary_current_applications.tex)

use aod::core:
    t1, ratio, select, evolve
    support_pi, support_rd, support_pressure, support_overhang

use stdlib::aod::ledger:
    clip_min, boundary_audit

struct Delta3:
    sign: t1
    mag: int

struct DoubleSlitBin:
    k: int
    s: int
    t0: int
    cx: int
    tx: int
    obs: int
    delta: int
    sign: t1
    mag: int

struct DoubleSlitSummary:
    sum_t0: int
    sum_cx: int
    sum_tx: int
    sum_obs: int
    sum_delta: int
    sum_mag: int
    center_sign: t1
    center_mag: int

struct ShortWindowRow:
    pi_val: int
    rd_val: int
    rho_clipped: int
    pressure: int
    overhang: int
    delta_close: int
    x_shedding: int

dec delta3_of:
    (pred: int, obs: int) where pred > obs -> Delta3:
        return Delta3(1t, pred - obs)
    (pred: int, obs: int) where pred < obs -> Delta3:
        return Delta3(t1(-1), obs - pred)
    (_: int, _: int) -> Delta3:
        return Delta3(0t, 0)

dec double_slit_bin_at:
    (k: int, s: int, cx: int, ob: int) -> DoubleSlitBin:
        let t0 = s + s
        let tx = t0 + cx
        let d = tx - ob
        let d3 = delta3_of(tx, ob)
        return DoubleSlitBin(k, s, t0, cx, tx, ob, d, d3.sign, d3.mag)

# Canonical 11-bin Dimonhexon double-slit cross-return bins (Manual Table 1, single source of truth)
dec double_slit_bins:
    () -> [DoubleSlitBin]:
        let s_bins = [4, 9, 16, 25, 31, 35, 31, 25, 16, 9, 4]
        let cx_bins = [0, -8, -12, 8, 18, 26, 18, 8, -12, -8, 0]
        let obs_bins = [8, 11, 19, 59, 79, 95, 80, 58, 21, 10, 8]
        return [
            double_slit_bin_at(-5, s_bins[0], cx_bins[0], obs_bins[0]),
            double_slit_bin_at(-4, s_bins[1], cx_bins[1], obs_bins[1]),
            double_slit_bin_at(-3, s_bins[2], cx_bins[2], obs_bins[2]),
            double_slit_bin_at(-2, s_bins[3], cx_bins[3], obs_bins[3]),
            double_slit_bin_at(-1, s_bins[4], cx_bins[4], obs_bins[4]),
            double_slit_bin_at(0, s_bins[5], cx_bins[5], obs_bins[5]),
            double_slit_bin_at(1, s_bins[6], cx_bins[6], obs_bins[6]),
            double_slit_bin_at(2, s_bins[7], cx_bins[7], obs_bins[7]),
            double_slit_bin_at(3, s_bins[8], cx_bins[8], obs_bins[8]),
            double_slit_bin_at(4, s_bins[9], cx_bins[9], obs_bins[9]),
            double_slit_bin_at(5, s_bins[10], cx_bins[10], obs_bins[10])
        ]

dec accum_slit_bin:
    (acc: DoubleSlitSummary, i: int, bins: [DoubleSlitBin]) -> DoubleSlitSummary:
        let b = bins[i]
        let c_sign = select(i == 5, b.sign, acc.center_sign)
        let c_mag = select(i == 5, b.mag, acc.center_mag)
        return DoubleSlitSummary(
            acc.sum_t0 + b.t0,
            acc.sum_cx + b.cx,
            acc.sum_tx + b.tx,
            acc.sum_obs + b.obs,
            acc.sum_delta + b.delta,
            acc.sum_mag + b.mag,
            c_sign,
            c_mag
        )

# Canonical 11-bin Dimonhexon double-slit cross-return summary (derived from double_slit_bins)
dec double_slit_eval:
    () -> DoubleSlitSummary:
        let bins = double_slit_bins()
        let zero = DoubleSlitSummary(0, 0, 0, 0, 0, 0, 0t, 0)
        return evolve(zero, 0..11, accum_slit_bin, bins)

dec eval_short_window:
    (sf: support, c3: int, h_mu: int, win_len: int, c_close: int) -> ShortWindowRow:
        let pi_v = support_pi(sf)
        let rd_v = support_rd(sf, h_mu)
        let rho_c = clip_min(rd_v, win_len)
        let p_d = support_pressure(sf, c3, h_mu, win_len)
        let q_d = support_overhang(sf, c3, h_mu, win_len)
        let aud = boundary_audit(p_d, c_close)
        return ShortWindowRow(pi_v, rd_v, rho_c, p_d, q_d, aud.delta_close, aud.x_shedding)

# Moving boundary signed flux: Phi_mov = Phi_cross - Phi_sweep + Phi_shedding
dec moving_boundary_flux:
    (cross: int, sweep: int, shedding: int) -> int:
        return cross - sweep + shedding

dec scoped_channel_flux:
    (c3: int, rho: int, win_len: int, att: ratio) -> ratio:
        let rho_c = clip_min(rho, win_len)
        return ratio(c3 * rho_c, 1) * att

dec stokes_cancellation:
    (forward_flux: ratio, reverse_flux: ratio) -> ratio:
        return forward_flux + reverse_flux

dec proton_support:
    () -> support:
        return 3:3:6

dec electron_support:
    () -> support:
        return 1:2:6

# Purely native 3:3:7_yro odd-length support (zero external mass map!)
dec saddle_337_support:
    () -> support:
        return 3:3:7_yro
