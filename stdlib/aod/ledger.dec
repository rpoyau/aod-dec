# AOD Manual §4 — Declared Edge Computation (D.E.C.) Ledger Standard Library
# Reference binding: rpoyau/aod@98ddfa0 (manual/sections/00_dec_ledger.tex)

use aod::core:
    ratio, min

use aod::ledger:
    sadar_promote, shedding_excess

struct KernelFour:
    p1: ratio
    p2: ratio
    p3: ratio
    p4: ratio
    total: int

struct RoleSums:
    neg_sum: ratio
    hinge_sum: ratio
    pos_sum: ratio

struct SlideThree:
    p1: ratio
    p2: ratio
    p3: ratio
    total: int
    returned_sum: ratio
    tunnel_prob: ratio

struct TunnelClipResult:
    rd_unclipped: int
    rho_clipped: int
    pressure: int
    tunnel_contrib: ratio

struct BoundaryAudit:
    pressure: int
    closure_cap: int
    delta_close: int
    x_shedding: int

dec clip_min:
    (a: int, b: int) -> int:
        return min(a, b)

dec isotropic_four:
    () -> KernelFour:
        return KernelFour(1/4r, 1/4r, 1/4r, 1/4r, 4)

dec normalize_four:
    (w1: int, w2: int, w3: int, w4: int) -> KernelFour:
        assert w1 >= 0 and w2 >= 0 and w3 >= 0 and w4 >= 0
        let z = w1 + w2 + w3 + w4
        assert z > 0
        return KernelFour(ratio(w1, z), ratio(w2, z), ratio(w3, z), ratio(w4, z), z)

dec add_role_weight:
    (acc: RoleSums, (-1t, p): (t1, ratio)) -> RoleSums:
        return RoleSums(acc.neg_sum + p, acc.hinge_sum, acc.pos_sum)
    (acc: RoleSums, (0t, p): (t1, ratio)) -> RoleSums:
        return RoleSums(acc.neg_sum, acc.hinge_sum + p, acc.pos_sum)
    (acc: RoleSums, (_, p): (t1, ratio)) -> RoleSums:
        return RoleSums(acc.neg_sum, acc.hinge_sum, acc.pos_sum + p)

dec role_sums_four:
    (k: KernelFour, s1: t1, s2: t1, s3: t1, s4: t1) -> RoleSums:
        let r0 = RoleSums(0/1r, 0/1r, 0/1r)
        let r1 = add_role_weight(r0, (s1, k.p1))
        let r2 = add_role_weight(r1, (s2, k.p2))
        let r3 = add_role_weight(r2, (s3, k.p3))
        return add_role_weight(r3, (s4, k.p4))

dec block_dwell_slide:
    (w1: int, w2: int, w3: int) -> SlideThree:
        assert w1 >= 0 and w2 >= 0 and w3 >= 0
        let z = w1 + w2 + w3
        assert z > 0
        let p1 = ratio(w1, z)
        let p2 = ratio(w2, z)
        let p3 = ratio(w3, z)
        return SlideThree(p1, p2, p3, z, p1 + p2, p3)

dec tunnel_clip:
    (rd_val: int, win_len: int, c3: int, tunnel_prob: ratio) -> TunnelClipResult:
        assert rd_val >= 0 and win_len >= 0 and c3 > 0
        let rho = clip_min(rd_val, win_len)
        let pd = c3 * rho
        let contrib = tunnel_prob * ratio(pd, 1)
        return TunnelClipResult(rd_val, rho, pd, contrib)

dec sadar_from_clipped:
    (c3: int, rho_clipped: int, att: ratio) -> ratio:
        return sadar_promote(c3, rho_clipped, att)

dec boundary_audit:
    (p_d: int, c_close: int) -> BoundaryAudit:
        let delta = p_d - c_close
        let xs = shedding_excess(p_d, c_close)
        return BoundaryAudit(p_d, c_close, delta, xs)

dec tau_missing_burden:
    (missing_num: int, missing_den: int) -> ratio:
        assert missing_den > 0
        return ratio(missing_num, missing_den)

dec r02_gap:
    (exact_val: ratio, rounded_proxy: ratio) -> ratio:
        return exact_val - rounded_proxy
