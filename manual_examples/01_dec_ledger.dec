# AOD Manual Fixture 01 — Manual §4 D.E.C. Ledger, Kernel Normalization, Hinge Slide,
# Field Tunnelling, ADAR/SADAR, 1:2:9_yro Surplus, Tau Missing-Burden, and R02 Gap

use aod::core:
    support_pi, support_rd, support_pressure, support_overhang
use stdlib::aod::ledger:
    isotropic_four, normalize_four, role_sums_four, block_dwell_slide,
    tunnel_clip, sadar_from_clipped, boundary_audit, tau_missing_burden, r02_gap

dec main() -> int:
    # 1. Isotropic 4-edge kernel (1/4)^4
    let iso = isotropic_four()
    assert iso.p1 == 1/4r and iso.p2 == 1/4r and iso.p3 == 1/4r and iso.p4 == 1/4r
    assert iso.p1 + iso.p2 + iso.p3 + iso.p4 == 1/1r

    # 2. Anisotropic kernel (1, 1, 4, 2) -> (1/8, 1/8, 1/2, 1/4) & role sums (1/8, 1/2, 3/8)
    let ani = normalize_four(1, 1, 4, 2)
    assert ani.p1 == 1/8r and ani.p2 == 1/8r and ani.p3 == 1/2r and ani.p4 == 1/4r
    let roles = role_sums_four(ani, +1t, -1t, 0t, +1t)
    assert roles.neg_sum == 1/8r and roles.hinge_sum == 1/2r and roles.pos_sum == 3/8r

    # 3. Blocked same-resolution dwell + hinge slide (3, 3, 1) -> (3/7, 3/7, 1/7)
    let slide = block_dwell_slide(3, 3, 1)
    assert slide.p1 == 3/7r and slide.p2 == 3/7r and slide.p3 == 1/7r
    assert slide.returned_sum == 6/7r and slide.tunnel_prob == 1/7r

    # 4. Field tunnelling window clip: RD=5 preserved unclipped, |w|=2 -> rho=2, p^D=6, T^D=6/7
    let tun = tunnel_clip(5, 2, 3, slide.tunnel_prob)
    assert tun.rd_unclipped == 5 and tun.rho_clipped == 2
    assert tun.pressure == 6 and tun.tunnel_contrib == 6/7r

    # 5. ADAR/SADAR promotion (C3=3, rho=4, A=+-1/3 -> +-4/1)
    let sad_pos = sadar_from_clipped(3, 4, 1/3r)
    let sad_neg = sadar_from_clipped(3, 4, -1/3r)
    assert sad_pos == 4/1r and sad_neg == -4/1r

    # 6. 1:2:9_yro surplus audit (Pi=4, RD=9, P^D=27, C_close=24 -> delta=3, X_shedding=3)
    let sf = 1:2:9_yro
    assert support_pi(sf) == 4 and support_rd(sf, 1) == 9
    let pd = support_pressure(sf, 3, 1, 9)
    let qd = support_overhang(sf, 3, 1, 9)
    assert pd == 27 and qd == 0
    let aud = boundary_audit(pd, 24)
    assert aud.delta_close == 3 and aud.x_shedding == 3

    # 7. Tau missing-burden exact ratio 31/50 and explicit R02 rounding gap 23/50 - 9/20 = 1/100 != 0
    let tau_mb = tau_missing_burden(31, 50)
    let gap = r02_gap(23/50r, 9/20r)
    assert tau_mb == 31/50r and gap == 1/100r and gap != 0/1r

    emit iso.p1
    emit ani.p1
    emit ani.p2
    emit ani.p3
    emit ani.p4
    emit roles.neg_sum
    emit roles.hinge_sum
    emit roles.pos_sum
    emit slide.returned_sum
    emit slide.tunnel_prob
    emit tun.rd_unclipped
    emit tun.tunnel_contrib
    emit sad_pos
    emit sad_neg
    emit aud.delta_close
    emit aud.x_shedding
    emit tau_mb
    emit gap
    0
