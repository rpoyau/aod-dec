# AOD Manual Fixture 04 — M3 PR #43 Cubical 4-Cube Measures, Quarter-Symmetry Disk Enclosures,
# 2x1 Rectangle Metric/Coord Swap, Exact Discrete-Law Moments, Affine Covariance, & Tesseract Transport

use stdlib::aod::cells::{
    four_cube_counts,
    four_cube_measure,
    disk_enclosure,
    rect_boundary,
    moments_from_atoms,
    affine_cov,
    tesseract_transport_16
}

Dec main() -> int:
    # 1. Filled 4-cube cell counts (16, 32, 24, 8, 1) -> total 81, Euler 1
    let fc = four_cube_counts()
    assert fc.v0 == 16 and fc.v1 == 32 and fc.v2 == 24 and fc.v3 == 8 and fc.v4 == 1
    assert fc.total == 81 and fc.euler == 1

    # 2. 4-cube volume and boundary 3-measure at a = 3/2
    let fm = four_cube_measure(3/2r)
    assert fm.vol4 == 81/16r and fm.bdry3 == 27/1r

    # 3. Unit-disk cubical enclosures at n = 1, 2, 4, 8, 16 via quarter-symmetry (`P1-2`)
    let d1 = disk_enclosure(1)
    let d2 = disk_enclosure(2)
    let d4 = disk_enclosure(4)
    let d8 = disk_enclosure(8)
    let d16 = disk_enclosure(16)
    assert d1.a_minus == 0/1r and d1.a_plus == 4/1r and d1.c_n == 8/1r
    assert d2.a_minus == 1/1r and d2.a_plus == 4/1r and d2.excess == 0/1r
    assert d4.a_minus == 2/1r and d4.a_plus == 15/4r and d4.excess == 1/2r
    assert d8.a_minus == 41/16r and d8.a_plus == 7/2r and d8.excess == 1/1r
    assert d16.a_minus == 183/64r and d16.a_plus == 107/32r and d16.c_n == 8/1r and d16.excess == 21/16r

    # 4. 2x1 rectangle coordinate swap vs metric+coordinate swap (10/1 -> 8/1 -> 10/1)
    let rect_orig = rect_boundary(2, 1, 2/1r, 1/1r)
    let rect_swap_coords = rect_boundary(1, 2, 2/1r, 1/1r)
    let rect_swap_both = rect_boundary(1, 2, 1/1r, 2/1r)
    assert rect_orig == 10/1r and rect_swap_coords == 8/1r and rect_swap_both == 10/1r

    # 5. Exact discrete-law moments (T, F, Rf, U) matching Manual 02_mapping_error.tex
    let p_3 = [1/4r, 1/2r, 1/4r]
    # T = 1 / ((1 + d)(1 - d)), d in {-1/100, 0, +1/100}
    let t_edge = 1/1r / ((1/1r + 1/100r) * (1/1r - 1/100r))
    let m_t = moments_from_atoms([t_edge, 1/1r, t_edge], p_3)
    assert m_t.mean == 19999/19998r and m_t.variance == 1/399920004r

    # F = (1 + d)(1 - 999*d/1000), d in {-1/100, 0, +1/100}
    let f_neg = (1/1r - 1/100r) * (1/1r + 999/100000r)
    let f_pos = (1/1r + 1/100r) * (1/1r - 999/100000r)
    let m_f = moments_from_atoms([f_neg, 1/1r, f_pos], p_3)
    assert m_f.mean == 19999001/20000000r and m_f.variance == 1018001/400000000000000r

    # Rf = (1 + d)(1 - d), d in {-1/2, 0, +1/2}
    let m_rf = moments_from_atoms([3/4r, 1/1r, 3/4r], p_3)
    assert m_rf.mean == 7/8r and m_rf.variance == 1/64r

    # U = 1/(1+y) + y, y in {-1/1000, +1/1000}, probs [1/2, 1/2]
    let u_neg = 1/1r / (1/1r - 1/1000r) - 1/1000r
    let u_pos = 1/1r / (1/1r + 1/1000r) + 1/1000r
    let m_u = moments_from_atoms([u_neg, u_pos], [1/2r, 1/2r])
    assert m_u.mean == 1000000/999999r and m_u.variance == 1/999998000001000000r

    # 6. Affine covariance (2X, 3X) with Var(X)=2 -> (8, 18, 12)
    let ac = affine_cov(2/1r, 3/1r, 2/1r)
    assert ac.var_a == 8/1r and ac.var_b == 18/1r and ac.cov_ab == 12/1r

    # 7. 16-step tesseract Q_4 cell transport conserving exact mass on every step
    let conserved = tesseract_transport_16(1024)
    assert conserved == 1024

    emit fc.total
    emit fc.euler
    emit fm.vol4
    emit fm.bdry3
    emit d16.a_minus
    emit d16.a_plus
    emit d16.c_n
    emit d16.excess
    emit rect_orig
    emit rect_swap_coords
    emit rect_swap_both
    emit m_t.mean
    emit m_t.variance
    emit m_f.mean
    emit m_f.variance
    emit m_rf.mean
    emit m_rf.variance
    emit m_u.mean
    emit m_u.variance
    emit ac.var_a
    emit ac.var_b
    emit ac.cov_ab
    emit conserved
    return 0
